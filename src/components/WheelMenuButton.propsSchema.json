    "required": false,
    "version": "",
    "isEvent": false,
    "bindable": true,
    "value": 500,
    "control": {
      "min": 100,
      "max": 1200,
      "step": 50
    }
  },
  {
    "name": "zIndex",
    "type": "number",
    "description": "层级，浮在其他内容之上",
    "default": "1000",
    "required": false,
    "version": "",
    "isEvent": false,
    "bindable": true,
    "value": 1000
