[
  {
    "name": "items",
    "type": "CircularMenuItem[]",
    "description": "菜单项，label 是文案，href 给了就走链接，active 是高亮态",
    "default": "",
    "required": true,
    "version": "",
    "isEvent": false,
    "bindable": false
  },
  {
    "name": "variant",
    "type": "'wheel' | 'fan'",
    "description": "形态：wheel 是半圆扇环，fan 是整圆扇环",
    "default": "\"wheel\"",
    "required": false,
    "version": "",
    "isEvent": false,
    "bindable": true,
    "value": "wheel",
    "control": {
      "options": {
        "wheel": "wheel",
        "fan": "fan"
      }
    }
  },
  {
    "name": "position",
    "type": "'relative' | 'absolute' | 'sticky' | 'fixed'",
    "description": "定位方式：relative 随文档流滚动，sticky 吸附，fixed 贴视口，absolute 贴定位祖先",
    "default": "\"relative\"",
    "required": false,
    "version": "",
    "isEvent": false,
    "bindable": true,
    "value": "relative",
    "control": {
      "options": {
        "relative": "relative",
        "absolute": "absolute",
        "sticky": "sticky",
        "fixed": "fixed"
      }
    }
  },
  {
    "name": "anchor",
    "type": "'center' | 'top' | 'bottom' | 'left' | 'right' | 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right'",
    "description": "锚点：非 relative 时按钮中心贴在哪条边，left/right 会在另一轴上居中",
    "default": "\"bottom\"",
    "required": false,
    "version": "",
    "isEvent": false,
    "bindable": true,
    "value": "bottom",
    "control": {
      "options": {
        "center": "center",
        "top": "top",
        "bottom": "bottom",
        "left": "left",
        "right": "right",
        "top-left": "top-left",
        "top-right": "top-right",
        "bottom-left": "bottom-left",
        "bottom-right": "bottom-right"
      }
    }
  },
  {
    "name": "offset",
    "type": "number",
    "description": "距锚点边的距离，单位 px",
    "default": "0",
    "required": false,
    "version": "",
    "isEvent": false,
    "bindable": true,
    "value": 0
  },
  {
    "name": "direction",
    "type": "'up' | 'down' | 'auto'",
    "description": "展开方向：up 向上展开，down 向下展开，auto 按锚点推断（贴顶时向下）",
    "default": "\"auto\"",
    "required": false,
    "version": "",
    "isEvent": false,
    "bindable": true,
    "value": "auto",
    "control": {
      "options": {
        "up": "up",
        "down": "down",
        "auto": "auto"
      }
    }
  },
  {
    "name": "overlay",
    "type": "boolean",
    "description": "是否显示半透明遮罩（一般配 fixed/absolute 使用）",
    "default": "false",
    "required": false,
    "version": "",
    "isEvent": false,
    "bindable": true,
    "value": false
  },
  {
    "name": "openText",
    "type": "string",
    "description": "展开时的按钮文案，不传则按形态用默认符号",
    "default": "",
    "required": false,
    "version": "",
    "isEvent": false,
    "bindable": true,
    "value": ""
  },
  {
    "name": "closeText",
    "type": "string",
    "description": "收起时的按钮文案，不传则按形态用默认符号",
    "default": "",
    "required": false,
    "version": "",
    "isEvent": false,
    "bindable": true,
    "value": ""
  }
]
